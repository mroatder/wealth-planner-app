SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=<publishable (anon) key from Supabase > Project Settings > API>

# How slips are read: vision (Google Cloud Vision, recommended) | auto (Vision first, Tesseract as fallback) | tesseract
OCR_PROVIDER=vision
# Google service-account key as base64 on ONE line (needed for vision / auto).
# Never put the real key in this example file. See DEPLOY.md for the one-line command that produces it.
GOOGLE_SERVICE_ACCOUNT_JSON=
